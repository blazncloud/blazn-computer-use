{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blazncloud/blazn-computer-use/qualification/result.schema.json",
  "title": "Blazn computer-use qualification result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "project", "commit", "taskId", "evidenceClass",
    "backend", "startedAt", "durationMs", "actionOutcome", "oracle",
    "artifacts", "environment"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "project": {"const": "blazncloud/blazn-computer-use"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "taskId": {"type": "string", "pattern": "^[A-Z][0-9]-[a-z0-9-]+$"},
    "evidenceClass": {
      "enum": ["unit", "protocol", "browser", "desktop", "remote", "consumer"]
    },
    "backend": {"type": "string", "minLength": 1},
    "client": {"type": "string"},
    "model": {"type": ["string", "null"]},
    "startedAt": {"type": "string", "format": "date-time"},
    "durationMs": {"type": "number", "minimum": 0},
    "actionOutcome": {
      "enum": [
        "read_only", "verified", "effect_not_verified", "refused",
        "stale", "ambiguous", "unsupported", "unknown_commit", "failed"
      ]
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "evidence"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "not_applicable"]},
        "evidence": {"type": "object"}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["os", "architecture"],
      "properties": {
        "os": {"type": "string"},
        "architecture": {"type": "string"}
      }
    }
  }
}
